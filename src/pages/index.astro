---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import LiveStream from '../components/LiveStream.astro';
import VoteCTA from '../components/VoteCTA.astro';
import Nominees from '../components/Nominees.astro';
import Books from '../components/Books.astro';
import NewsFeed from '../components/NewsFeed.astro';
import Blog from '../components/Blog.astro';
import Notes from '../components/Notes.astro';
import EventDates from '../components/EventDates.astro';
import SocialFeed from '../components/SocialFeed.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Footer from '../components/Footer.astro';

// React Components
import Navbar from '../components/Navbar';
import Countdown from '../components/Countdown';
import Carousel from '../components/Carousel';
import Testimonials from '../components/Testimonials';
---

<Layout title="PRAISE MUSIC AWARDS // La Gala de la Música Cristiana">
    <Navbar client:load />

	<main>
		<!-- HERO -->
		<Hero />

        <!-- CUENTA REGRESIVA -->
        <Countdown client:load />

		<!-- SOBRE EL PREMIO -->
		<About />

        <!-- EN VIVO -->
        <LiveStream />

        <!-- VOTAR -->
        <VoteCTA />

        <!-- MÚSICA / NOMINADOS -->
        <Nominees />

        <!-- LIBROS -->
        <Books />

        <!-- NOTICIAS -->
        <NewsFeed />

        <!-- BLOG -->
        <Blog />

        <!-- NOTAS -->
        <Notes />

        <!-- FECHAS Y SEDES -->
        <EventDates />

        <!-- GALERÍA -->
        <Carousel client:visible />

        <!-- TESTIMONIOS -->
        <Testimonials client:visible />

        <!-- SOCIAL -->
        <SocialFeed />
        <SocialLinks />

        <Footer />
	</main>
</Layout>

---
const { title = "PRAISE MUSIC AWARDS // La Gala de la Música Cristiana" } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Praise Music Awards — la premiación que celebra lo mejor de la música, las noticias y los autores cristianos. Vota por tus favoritos y vive la gala en vivo."
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div id="preloader" class="preloader">
			<span class="crest mono">✦ PMA ✦</span>
			<h1
				class="gold-text"
				style="font-size: clamp(2rem, 6vw, 3.6rem); text-align:center;"
			>
				PRAISE MUSIC AWARDS
			</h1>
			<div
				class="mono"
				style="margin-top: 16px; color: var(--muted); letter-spacing: 0.2em;"
			>
				Preparando la gala...
			</div>
		</div>

		<slot />

		<script>
			window.addEventListener("load", () => {
				window.scrollTo(0, 0);
				document.body.style.overflow = "hidden";

				setTimeout(() => {
					const preloader = document.getElementById("preloader");
					if (preloader) {
						preloader.classList.add("fade-out");
					}
					document.body.style.overflow = "";
				}, 1600);
			});
		</script>
		<script src="../scripts/reveal.ts"></script>
	</body>
</html>

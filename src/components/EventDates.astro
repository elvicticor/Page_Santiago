---
---
<section id="fechas" class="container">
    <div class="section-header reveal">
        <h3>Fechas y sedes</h3>
        <span class="mono section-eyebrow">GIRA_DE_PREMIACIÓN</span>
    </div>
    <div class="table-wrapper reveal" style="overflow-x: auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>FECHA</th>
                    <th>CIUDAD</th>
                    <th>SEDE</th>
                    <th style="text-align: right;">ESTADO</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="mono">05.12.2026</td>
                    <td>Bogotá, Colombia</td>
                    <td class="mono" style="color: var(--muted);">Auditorio G12</td>
                    <td style="text-align: right;"><span
                            class="status-badge status-soldout mono">Agotado</span>
                    </td>
                </tr>
                <tr>
                    <td class="mono">12.12.2026</td>
                    <td>Medellín, Colombia</td>
                    <td class="mono" style="color: var(--muted);">La Macarena</td>
                    <td style="text-align: right;"><span
                            class="status-badge status-available mono">Entradas</span>
                    </td>
                </tr>
                <tr>
                    <td class="mono">19.12.2026</td>
                    <td>Lima, Perú</td>
                    <td class="mono" style="color: var(--muted);">Estadio Nacional</td>
                    <td style="text-align: right;"><span
                            class="status-badge status-available mono">Entradas</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section id="hero" class="hero container">
    <div class="hero-content">
        <div class="hero-text">
            <span class="mono hero-eyebrow reveal">✦ 3RA EDICIÓN // 2026</span>
            <h1 class="gold-text shimmer reveal" style="font-family: var(--font-display);">
                PRAISE MUSIC AWARDS
            </h1>
            <span class="subtitle reveal">
                La gala que celebra lo mejor de la música, las noticias, los autores
                y las historias que inspiran fe. Vota por tus favoritos y sé parte de
                la noche más esperada de la música cristiana.
            </span>
            <div class="hero-cta-group reveal">
                <a href="#live" class="btn btn-gold">Ver en vivo</a>
                <a href="#vote" class="btn btn-outline">Vota ahora</a>
            </div>
        </div>
        <div class="hero-visual reveal">
            <div class="trophy-frame">
                <img
                    src="https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?q=80&w=1200&auto=format&fit=crop"
                    alt="Gala de premiación"
                />
                <div class="frame-caption">
                    <span class="mono">Bogotá, Colombia — Diciembre 2026</span>
                </div>
            </div>
        </div>
    </div>
</section>
